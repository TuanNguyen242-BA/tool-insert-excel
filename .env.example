# local: generate ngay trong request web
# cloud: upload input len GCS, tao Firestore job, goi Cloud Run Job
DOCX_BUILDER_MODE=local

# Tuy chon khi chay local: duong dan toi soffice.exe de tao preview PDF.
# Vi du Windows cai dat binh thuong:
# LIBREOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe
# Vi du LibreOffice Portable:
# LIBREOFFICE_BIN=D:\Apps\LibreOfficePortable\App\libreoffice\program\soffice.exe

# Bat buoc khi DOCX_BUILDER_MODE=cloud
PROJECT_ID=your-gcp-project-id
REGION=asia-southeast1
GCS_BUCKET=your-gcp-project-id-docx-builder
WORKER_JOB_NAME=tool-insert-excel-worker
FIRESTORE_JOBS_COLLECTION=docx_jobs

# Tuy chon: override timeout moi lan web goi job
# WORKER_TASK_TIMEOUT=7200s
